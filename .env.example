# Path to your OpenSky credentials JSON file when running scripts from src/data.
CREDENTIALS_PATH=path-to-your-credentials.json

# MongoDB Atlas connection settings.
# Copy the connection string from Atlas and replace the username and password.
MONGO_URI=mongodb+srv://your-mongodb-username:your-mongodb-password@your-cluster.mongodb.net/?retryWrites=true&w=majority
DB_NAME=airline-data
COLLECTION_ARRIVALS=arrivals
COLLECTION_DEPARTURES=departures

# Connection string from your Neon account.
DATABASE_URL=your-connection-string
